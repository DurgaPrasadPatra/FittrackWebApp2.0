# Base image: Python pre-installed, "slim" keeps it small
FROM python:3.12-slim

# All following instructions run relative to this folder inside the container
WORKDIR /code

# Copy ONLY requirements first — this layer gets cached and skipped
# on rebuilds unless requirements.txt itself changes
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy the actual code last, since it changes more often than dependencies
COPY app ./app

# Documents the port (metadata only — doesn't publish it)
EXPOSE 8000

# Default startup command — exec form, so uvicorn is PID 1 and
# receives shutdown signals properly
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
